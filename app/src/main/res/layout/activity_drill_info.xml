<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DrillInfoActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/drillImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/drillName"
            android:text="@string/drill_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>
        <TextView
            android:id="@+id/drillDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/this_is_a_description"
            android:layout_marginTop="9dp"/>
        <TextView
            android:id="@+id/drillTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tips_follow_this_instruction_carefully"
            android:layout_marginTop="9dp"/>
        <Button
            android:id="@+id/stratButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_ar_drill"
            android:layout_marginTop="25dp"/>
    </LinearLayout>

</ScrollView>